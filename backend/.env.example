# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=mongodb://127.0.0.1:27017/tea
# 32+ random characters, e.g. `openssl rand -hex 32`
SECRET=
PORT=3001
# Origin allowed by CORS (the frontend)
FRONTEND_ORIGIN=http://localhost:5173
CLOUDINARY_URL=
# Gmail app password for outgoing mail
USER_EMAIL=
USER_PASSWORD=
# Google OpenID Connect (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
